/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' ws: wss: https://cloudflareinsights.com; script-src 'self' blob: 'wasm-unsafe-eval' https: http:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/manifest+json

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The SW must revalidate every launch or updates lag up to 24 h
# (dev-material/service-worker-design.md).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
